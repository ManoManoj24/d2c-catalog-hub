{
  "key": "kidswear",
  "version": 1,
  "name": "Kidswear Pack",
  "variationThemeDefault": "SizeColor",
  "description": "Installable configuration for Indian kidswear catalogs. Statutory and tax values are versioned data in this file, not application constants.",
  "attributes": [
    {
      "key": "style_code",
      "label": "Style code",
      "dataType": "text",
      "scope": "style",
      "groupKey": "identity",
      "groupLabel": "Identity",
      "sortOrder": 10,
      "required": true,
      "help": "Stable parent style identifier. Used to match styles on re-import.",
      "rules": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,40}$", "maxLength": 41 }
    },
    {
      "key": "style_name",
      "label": "Style name",
      "dataType": "text",
      "scope": "style",
      "groupKey": "identity",
      "groupLabel": "Identity",
      "sortOrder": 20,
      "required": true,
      "help": "Customer-facing style title shared by every color and size.",
      "rules": { "maxLength": 200 }
    },
    {
      "key": "brand",
      "label": "Brand",
      "dataType": "text",
      "scope": "style",
      "groupKey": "identity",
      "groupLabel": "Identity",
      "sortOrder": 30,
      "required": true,
      "rules": { "maxLength": 120 }
    },
    {
      "key": "variation_theme",
      "label": "Variation theme",
      "dataType": "picklist",
      "scope": "style",
      "groupKey": "variation",
      "groupLabel": "Variation",
      "sortOrder": 40,
      "required": true,
      "help": "SizeColor is the kidswear default. Confirm it against each channel template before publishing.",
      "rules": { "picklistKey": "variation_theme" }
    },
    {
      "key": "color",
      "label": "Color",
      "dataType": "picklist",
      "scope": "colorway",
      "groupKey": "variation",
      "groupLabel": "Variation",
      "sortOrder": 50,
      "required": false,
      "help": "Colorway label. Required when the variation theme includes color.",
      "rules": { "picklistKey": "color" }
    },
    {
      "key": "color_code",
      "label": "Color code",
      "dataType": "text",
      "scope": "colorway",
      "groupKey": "variation",
      "groupLabel": "Variation",
      "sortOrder": 60,
      "required": false,
      "help": "Stable code for the colorway. Media and fabric hang off this code, not off each size.",
      "rules": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,20}$", "maxLength": 21 }
    },
    {
      "key": "size",
      "label": "Size",
      "dataType": "picklist",
      "scope": "sku",
      "groupKey": "variation",
      "groupLabel": "Variation",
      "sortOrder": 70,
      "required": false,
      "help": "Sellable size. Required when the variation theme includes size.",
      "rules": { "picklistKey": "size" }
    },
    {
      "key": "sku",
      "label": "SKU",
      "dataType": "text",
      "scope": "sku",
      "groupKey": "variation",
      "groupLabel": "Variation",
      "sortOrder": 80,
      "required": true,
      "help": "Sellable size SKU. Unique inside the catalog. Default match key on import.",
      "rules": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,64}$", "maxLength": 65 }
    },
    {
      "key": "barcode",
      "label": "Barcode",
      "dataType": "text",
      "scope": "sku",
      "groupKey": "variation",
      "groupLabel": "Variation",
      "sortOrder": 90,
      "required": false,
      "rules": { "pattern": "^[0-9]{8,14}$", "maxLength": 14 }
    },
    {
      "key": "mfg_pack_month_year",
      "label": "Manufacture or packing month",
      "dataType": "month_year",
      "scope": "style",
      "groupKey": "legal_metrology",
      "groupLabel": "Legal Metrology",
      "sortOrder": 100,
      "required": true,
      "help": "Month and year of manufacture or packing. Stored as YYYY-MM. MM-YYYY is accepted on import and normalized.",
      "rules": { "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" }
    },
    {
      "key": "net_quantity",
      "label": "Net quantity",
      "dataType": "text",
      "scope": "style",
      "groupKey": "legal_metrology",
      "groupLabel": "Legal Metrology",
      "sortOrder": 110,
      "required": true,
      "help": "Examples: 1 N, 2 N set.",
      "rules": { "pattern": "^[0-9]+\\s*N(\\s+set)?$", "maxLength": 32 }
    },
    {
      "key": "country_of_origin",
      "label": "Country of origin",
      "dataType": "picklist",
      "scope": "style",
      "groupKey": "business_identity",
      "groupLabel": "Business identity",
      "sortOrder": 120,
      "required": true,
      "rules": { "picklistKey": "country_of_origin" }
    },
    {
      "key": "manufacturer_name",
      "label": "Manufacturer name",
      "dataType": "text",
      "scope": "style",
      "groupKey": "business_identity",
      "groupLabel": "Business identity",
      "sortOrder": 130,
      "required": true,
      "rules": { "maxLength": 200 }
    },
    {
      "key": "manufacturer_address",
      "label": "Manufacturer address",
      "dataType": "text",
      "scope": "style",
      "groupKey": "business_identity",
      "groupLabel": "Business identity",
      "sortOrder": 140,
      "required": true,
      "help": "Complete manufacturer address as printed for Legal Metrology.",
      "rules": { "maxLength": 500 }
    },
    {
      "key": "packer_name",
      "label": "Packer name",
      "dataType": "text",
      "scope": "style",
      "groupKey": "business_identity",
      "groupLabel": "Business identity",
      "sortOrder": 150,
      "required": true,
      "rules": { "maxLength": 200 }
    },
    {
      "key": "packer_address",
      "label": "Packer address",
      "dataType": "text",
      "scope": "style",
      "groupKey": "business_identity",
      "groupLabel": "Business identity",
      "sortOrder": 160,
      "required": true,
      "rules": { "maxLength": 500 }
    },
    {
      "key": "hsn_code",
      "label": "HSN code",
      "dataType": "picklist",
      "scope": "style",
      "groupKey": "taxation",
      "groupLabel": "Taxation",
      "sortOrder": 170,
      "required": true,
      "help": "Allowed codes come from the active tax schedule installed with this pack version.",
      "rules": { "picklistKey": "hsn_code" }
    },
    {
      "key": "gst_rate",
      "label": "GST rate",
      "dataType": "number",
      "scope": "style",
      "groupKey": "taxation",
      "groupLabel": "Taxation",
      "sortOrder": 180,
      "required": true,
      "help": "Percent. Checked against the active tax schedule using MRP as a provisional price basis. This is not a filing opinion.",
      "rules": { "min": 0, "max": 100 }
    },
    {
      "key": "age_range",
      "label": "Age range",
      "dataType": "picklist",
      "scope": "style",
      "groupKey": "consumer_sizing",
      "groupLabel": "Consumer sizing",
      "sortOrder": 190,
      "required": true,
      "help": "Customer-facing age band, such as 2-3Y. Measured chest and length stay on the size SKU.",
      "rules": { "picklistKey": "age_range" }
    },
    {
      "key": "size_unit",
      "label": "Measurement unit",
      "dataType": "picklist",
      "scope": "style",
      "groupKey": "consumer_sizing",
      "groupLabel": "Consumer sizing",
      "sortOrder": 200,
      "required": true,
      "help": "Unit for chest and length. Import keeps the raw number; channels receive the unit explicitly.",
      "rules": { "picklistKey": "size_unit" }
    },
    {
      "key": "chest",
      "label": "Chest",
      "dataType": "measurement",
      "scope": "sku",
      "groupKey": "consumer_sizing",
      "groupLabel": "Consumer sizing",
      "sortOrder": 210,
      "required": true,
      "rules": { "min": 10, "max": 80 }
    },
    {
      "key": "length",
      "label": "Length",
      "dataType": "measurement",
      "scope": "sku",
      "groupKey": "consumer_sizing",
      "groupLabel": "Consumer sizing",
      "sortOrder": 220,
      "required": true,
      "rules": { "min": 10, "max": 120 }
    },
    {
      "key": "mrp",
      "label": "MRP",
      "dataType": "number",
      "scope": "sku",
      "groupKey": "taxation",
      "groupLabel": "Taxation",
      "sortOrder": 230,
      "required": true,
      "help": "Maximum retail price in INR. The active tax schedule uses it as a provisional sale-value proxy until the price basis is confirmed.",
      "rules": { "min": 1, "max": 100000 }
    },
    {
      "key": "fabric",
      "label": "Fabric",
      "dataType": "picklist",
      "scope": "colorway",
      "groupKey": "identity",
      "groupLabel": "Identity",
      "sortOrder": 240,
      "required": true,
      "rules": { "picklistKey": "fabric" }
    },
    {
      "key": "care",
      "label": "Care",
      "dataType": "text",
      "scope": "colorway",
      "groupKey": "identity",
      "groupLabel": "Identity",
      "sortOrder": 250,
      "required": false,
      "rules": { "maxLength": 300 }
    },
    {
      "key": "main_image_url",
      "label": "Main image URL",
      "dataType": "url",
      "scope": "colorway",
      "groupKey": "media",
      "groupLabel": "Media",
      "sortOrder": 260,
      "required": true,
      "help": "Checked with HTTP HEAD. Size SKUs inherit this colorway image unless a size-specific override is uploaded.",
      "rules": { "maxLength": 1000 }
    },
    {
      "key": "alt_image_url",
      "label": "Alternate image URL",
      "dataType": "url",
      "scope": "colorway",
      "groupKey": "media",
      "groupLabel": "Media",
      "sortOrder": 270,
      "required": false,
      "rules": { "maxLength": 1000 }
    }
  ],
