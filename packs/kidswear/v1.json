  "channels": [
    {
      "key": "generic_marketplace",
      "name": "Generic marketplace file",
      "format": "xlsx",
      "templateFile": "templates/generic-kidswear-v1.xlsx",
      "dataSheet": "Data",
      "headerRow": 3,
      "insertionRow": 4,
      "columns": [
        { "header": "Row Type", "attribute": "row_type", "scope": "derived", "required": true, "derived": "row_type" },
        { "header": "Style Code", "attribute": "style_code", "scope": "style", "required": true },
        { "header": "Product Name", "attribute": "style_name", "scope": "style", "required": true },
        { "header": "Brand", "attribute": "brand", "scope": "style", "required": true },
        { "header": "Parent Style", "attribute": "parent_style", "scope": "derived", "required": false, "derived": "parent_style" },
        { "header": "Color", "attribute": "color", "scope": "colorway", "required": true },
        { "header": "Size", "attribute": "size", "scope": "sku", "required": true },
        { "header": "SKU", "attribute": "sku", "scope": "sku", "required": true },
        { "header": "Barcode", "attribute": "barcode", "scope": "sku", "required": false },
        { "header": "MRP", "attribute": "mrp", "scope": "sku", "required": true },
        { "header": "HSN", "attribute": "hsn_code", "scope": "style", "required": true },
        { "header": "GST Percent", "attribute": "gst_rate", "scope": "style", "required": true },
        { "header": "Age Range", "attribute": "age_range", "scope": "style", "required": true },
        { "header": "Net Quantity", "attribute": "net_quantity", "scope": "style", "required": true },
        { "header": "Country of Origin", "attribute": "country_of_origin", "scope": "style", "required": true },
        { "header": "Mfg Pack", "attribute": "mfg_pack_month_year", "scope": "style", "required": true },
        { "header": "Main Image", "attribute": "main_image_url", "scope": "colorway", "required": true },
        { "header": "Fabric", "attribute": "fabric", "scope": "colorway", "required": false }
      ]
    }
  ],
  "media": {
    "scopes": ["style", "colorway", "sku"],
    "inheritance": "Size SKUs inherit colorway media. A SKU-scoped asset overrides that role only.",
    "allowedContentTypes": ["image/jpeg", "image/png", "image/webp"]
  },
  "limits": {
    "storageCapBytes": 104857600,
    "maxUploadBytes": 5242880,
    "maxImportBytes": 20971520,
    "maxImportRows": 5000,
    "maxCellLength": 2000,
    "allowedImageTypes": ["image/jpeg", "image/png", "image/webp"],
    "allowedImportTypes": [
      "text/csv",
      "application/csv",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    ]
  }
}
