  "relationshipRules": [
    {
      "id": "sizecolor-parentage",
      "when": { "attribute": "variation_theme", "equals": "SizeColor" },
      "require": ["color", "color_code", "size", "style_code", "sku"]
    },
    {
      "id": "size-parentage",
      "when": { "attribute": "variation_theme", "equals": "Size" },
      "require": ["size", "style_code", "sku"]
    },
    {
      "id": "color-parentage",
      "when": { "attribute": "variation_theme", "equals": "Color" },
      "require": ["color", "color_code", "style_code", "sku"]
    }
  ],
