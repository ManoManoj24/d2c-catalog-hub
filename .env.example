# Superuser connection used only for migrations and seed.
DATABASE_URL=postgres://pim:pim@localhost:5432/pim

# Application role. Row-level security applies. Not a superuser.
APP_DATABASE_URL=postgres://pim_app:pim_app@localhost:5432/pim

# Signs session cookies and public media URLs. Use a long random value outside local dev.
SESSION_SECRET=replace-with-a-long-random-string

# Public origin used when media checks and delivery URLs call this app.
APP_ORIGIN=http://127.0.0.1:3000

# Filesystem object store root (logical keys stay tenant-scoped).
OBJECT_STORE=fs
OBJECT_STORE_PATH=./data/objects

# S3-compatible adapter. Used only when OBJECT_STORE=s3.
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=ap-south-1
# S3_BUCKET=pim-lite-dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Local demo image URLs point at this app. Do not enable in production.
ALLOW_LOCAL_MEDIA_URLS=true

# inline: the web process kicks the queue. external: run `npm run worker`.
JOB_MODE=inline
JOB_BATCH_SIZE=250

# Test database (used by `npm test` when present).
# TEST_DATABASE_URL=postgres://pim:pim@localhost:5432/pim_test
# TEST_APP_DATABASE_URL=postgres://pim_app:pim_app@localhost:5432/pim_test
